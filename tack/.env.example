# Copy to .env for local development. Never commit the real file.

NODE_ENV=development
PORT=3000

# Matches the db service in docker-compose.yml
DATABASE_URL=postgres://tack:tack@localhost:5432/tack
# Set to true for managed Postgres that requires TLS
DATABASE_SSL=false

# Session cookies are Secure in production. Set to false only for plain-http demos.
COOKIE_SECURE=
# Number of reverse proxies in front of the app (Render, Fly, Railway: 1)
TRUST_PROXY=0
# Extra origins allowed to make state-changing requests, comma separated
ALLOWED_ORIGINS=

LOG_LEVEL=info
