{
  "name": "tack",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hostable kanban board with real-time collaboration.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @tack/api\" \"npm run dev -w @tack/web\"",
    "build": "npm run build -w @tack/web && npm run build -w @tack/api",
    "start": "npm run start -w @tack/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @tack/api",
    "db:seed": "npm run db:seed -w @tack/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
